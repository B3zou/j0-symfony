# Variables d'environnement de l'API Symfony.
# Ne mettez PAS de secret réel ici : surchargez dans .env.local (non versionné).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=7f3c1d0b9a2e4c6f8d5b3a1e9c7f2d4b
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# L'hôte « database » est le nom du service PostgreSQL dans compose.yaml
DATABASE_URL="postgresql://app:app@database:5432/app?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###
